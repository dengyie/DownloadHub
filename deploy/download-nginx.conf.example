# Include inside nginx's http {}. Requires http_realip_module.
# REVIEW ONLY: do not replace unrelated host sites. CF Tunnel ingress MUST target
# http://localhost:80 (loopback IPv4/IPv6); no other public listener may expose this server block.
# Only local cloudflared is trusted here; local processes are privileged peers.
# Build frontend/dist and publish it to this read-only root. The Go API is API-only;
# remove the retired frontend_dir/api_only configuration keys on upgrade. This
# example must be compared with the current production site before deployment.
log_format download_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                         '$status $body_bytes_sent $request_time';

# Omitting cache headers on errors still permits CDN/browser heuristic caching.
# Cache only successful static responses; every other status is explicitly no-store.
map $status $download_immutable_cache {
    default "no-store";
    ~^(200|206|304)$ "public, max-age=31536000, immutable";
}
map $status $download_public_cache {
    default "no-store";
    ~^(200|206|304)$ "public, max-age=86400";
}

server {
    listen 127.0.0.1:80;
    listen [::1]:80;
    server_name download.example.com;
    root /var/www/download-ui/current;
    default_type application/octet-stream;
    types {
        text/html html;
        text/javascript js;
        text/css css;
        image/png png;
        image/x-icon ico;
        application/vnd.android.package-archive apk;
    }
    merge_slashes off;
    # Check the raw path before nginx normalizes dot segments or decoded
    # separators into a different route. Query values are deliberately excluded.
    if ($request_uri ~* "^[^?]*(%2f|%5c|%0[0-9a-f]|%1[0-9a-f]|%7f)") { return 400; }
    if ($request_uri ~* "^([^?]*/)(\\.|%2e){1,2}(/|\\?|$)") { return 400; }
    if ($uri ~ "//|\\x5c") { return 400; }
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive off;
    access_log /var/log/nginx/download-safe.log download_safe;
    # nginx error logs can include raw request lines. Keep them restricted and
    # never enable debug logging for production authorization requests.
    error_log /var/log/nginx/download-error.log crit;

    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy no-referrer always;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Overwrite, do not append untrusted client input.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header CF-Connecting-IP "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 20s;
    proxy_cache off;

    location = /health { return 404; }
    location = /ready { return 404; }
    location = /metrics { return 404; }
    location /files/ { return 404; }
    location = /files { return 404; }

    # Only known fingerprinted files are immutable. Missing assets remain 404,
    # never index.html. Keep previous releases until existing tabs have expired.
    location = /ui/captcha.js {
        try_files $uri =404;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
    }
    location /ui/ { return 404; }
    location ~ "^/ui/[a-f0-9]{24}/[A-Za-z0-9_/-]+\.(?:js|css)$" {
        try_files $uri =404;
        add_header Cache-Control $download_immutable_cache always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
    }
    location /brand/ { return 404; }
    location ~ "^/brand/(?:logo\.png|favicon\.ico|apple-touch-icon\.png)$" {
        try_files $uri =404;
        add_header Cache-Control $download_public_cache always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
    }

    # This list mirrors frontend/src/router.js. Never use
    # a site-wide try_files fallback: it would swallow APIs, payment and admin.
    location ~ "^(?:/|/(?:redeem|help|orders|resources/[a-z0-9-]+|item/[1-9][0-9]*|cat/(?:[0-9]+|recommend)|user/index/(?:index|item|query)|user/authentication/(?:login|register|emailForget|phoneForget)|user/dashboard/index)/?)$" {
        try_files /index.html =503;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
    }
    # Old links show a confirmation page. The browser validates the resource and
    # scrubs card/key/token query values; GET/HEAD never issue a grant or debit.
    location /dl/ { return 404; }
    location ~ "^/dl/(?:[^/,?#]+/)*[^/,?#]+$" {
        try_files /index.html =503;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
    }
    location ^~ /api/ {
        client_max_body_size 16k;
        proxy_pass http://127.0.0.1:8080;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy no-referrer always;
    }
    # Keep the existing 64 KiB limit for both checkout APIs and cashier posts.
    location ~ "^/user/(?:api|pay)/" {
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:8081;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy no-referrer always;
    }
    location ^~ /p/ {
        proxy_pass http://127.0.0.1:5244;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy no-referrer always;
    }
    # Public distribution only. Never place card-protected resources here.
    # Existing manual.txt classification requires an operator decision.
    location ^~ /pub/ {
        alias /data/share/pub/;
        autoindex off;
        add_header Cache-Control $download_public_cache always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy no-referrer always;
    }
    # Existing customer-center operations, /user/captcha/, /user/pay/, /pay/,
    # /admin/, commerce assets and unknown routes remain PHP-owned. Do not apply
    # the SPA's no-inline CSP to legacy PHP documents or payment plugin pages.
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy no-referrer always;
    }
}
