# Keep credentials in a restricted local file; never commit the filled config.
listen: "127.0.0.1:8080"
db_path: "/root/cardgw/cards.db"
openlist_url: "http://127.0.0.1:5244"
openlist_admin_user: "admin"
openlist_admin_pass: "CHANGE_ME"

# Fixed maximum recovery window; repeat requests do not extend it.
grant_window_seconds: 600
# REQUIRED: verify the minimum remaining lifetime of returned OpenList URLs.
# Zero deliberately fails startup. Do not guess a provider's signing lifetime.
# Must be >= grant_window_seconds, <= 86400.
openlist_min_url_ttl_seconds: 0
# Exact allowed host[:port] of absolute signed URLs. Relative URLs are supported.
# Add actual externally reachable storage hosts after verifying the backend.
download_hosts: ["download.mangoqwq.com"]
# Only the reviewed loopback nginx can supply X-Real-IP; default is trust nobody.
trusted_proxy_cidrs: ["127.0.0.1/32"]
# No quota is charged for resources under a public static alias.
# Relative, trailing slash, no leading slash. Match all deployed public aliases.
public_prefixes: ["pub/"]
audit_retention_days: 90
# The gateway is API-only. Serve frontend/dist independently through nginx.
# Remove the retired frontend_dir/api_only keys when upgrading old configs.
# Optional curated JSON catalog; empty uses the reviewed catalog/public.json.
public_catalog_path: ""
